<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ reads these instead of android:allowBackup. As before: nothing goes to cloud
     backup (allowBackup="false"), and a device-to-device transfer to a new phone still copies the
     app's data, which allowBackup="false" never stopped on Android 12+. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
