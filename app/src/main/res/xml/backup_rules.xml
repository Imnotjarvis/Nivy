<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower read these instead of data_extraction_rules.xml. Same answer: nothing is
     backed up (there, android:allowBackup="false" already says so; this spells it out). -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
